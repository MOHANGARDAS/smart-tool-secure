# ── SMART-TOOL/M configuration ──
# Copy this file to `.env` (never commit .env).

# AI engine (free Gemini key: https://aistudio.google.com/app/apikey)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# GitHub (PAT with `repo` scope: github.com -> Settings -> Developer settings)
GITHUB_TOKEN=
GITHUB_OWNER=MOHANGARDAS
GITHUB_REPO=smart-tool-secure
GITHUB_BRANCH=main

# Security
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=1121

# Server
PORT=3000
# DATA_DIR=/app/data   (set in Docker so data survives restarts)
